# ============================================================================
# Torneo Socorro Senior Master Plus 40 — variables de entorno para desarrollo
# local en VSCode.
#
# Copia este archivo a ".env" (en la raíz) y ajusta lo que necesites.
# Todos los scripts en package.json lo leen automáticamente con dotenv.
# ============================================================================

# --- Base de datos (Postgres) ------------------------------------------------
# Si usas el docker-compose incluido (docker compose up -d db), esta URL ya
# funciona sin cambios.
DATABASE_URL=postgresql://torneo:torneo@localhost:5432/torneo_socorro

# --- api-server (backend Express) -------------------------------------------
PORT=4000
# Secreto para firmar las sesiones de login. Cámbialo por cualquier texto
# largo y aleatorio antes de usar esto con el torneo real.
AUTH_SECRET=cambia-este-valor-por-un-texto-aleatorio-largo

# --- torneo-socorro (frontend Vite) -----------------------------------------
# Puerto donde corre la app en el navegador (http://localhost:5173)
# Se usa un nombre distinto (VITE no, porque vite.config.ts lo lee de
# process.env directamente, no vía import.meta.env).
FRONTEND_PORT=5173
BASE_PATH=/
# Debe coincidir con el PORT del api-server de arriba; el proxy del frontend
# reenvía las llamadas a /api hacia http://localhost:API_PORT
API_PORT=4000
